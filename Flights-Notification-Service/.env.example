# Replace placeholders with values for this laptop. Never commit the .env file.
PORT=3003
# Optional: leave both blank for clearly labeled local notification logging.
# For Gmail delivery, configure a Gmail address and an App Password yourself.
GMAIL_EMAIL=
GMAIL_PASS=
DB_NAME=notification_service_db
DB_USERNAME=your_mysql_username
DB_PASSWORD=replace-with-your-local-mysql-password
DB_HOST=127.0.0.1
DB_DIALECT=mysql
