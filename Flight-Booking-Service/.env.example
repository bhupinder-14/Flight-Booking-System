# Replace placeholders with values for this laptop. Never commit the .env file.
PORT=3001
FLIGHT_SERVICE=http://localhost:3000
# Keep the spelling RECEPIENT_EMAIL; it is what the application reads.
RECEPIENT_EMAIL=demo@example.com
DB_NAME=booking_service_db
DB_USERNAME=your_mysql_username
DB_PASSWORD=replace-with-your-local-mysql-password
DB_HOST=127.0.0.1
DB_DIALECT=mysql
